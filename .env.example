# Copy to .env and fill in. Never commit .env.

# Postgres. Local throwaway cluster or Supabase (use the pooled connection string, sslmode=require).
DATABASE_URL=postgresql://postgres@localhost:5545/paladin

# Google Gemini (the only model provider). Two auth modes; Vertex wins when enabled.
# Mode 1, Vertex AI with Application Default Credentials (supports Google Search grounding):
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Mode 2, Gemini API key (AI Studio). Free-tier keys have small per-model daily caps.
GEMINI_API_KEY=
PALADIN_MODEL_EXTRACT=gemini-3.5-flash
PALADIN_MODEL_BRIEF=gemini-3.5-flash
PALADIN_MODEL_GROUNDED=gemini-3.5-flash
# 1 = also use Gemini with Google Search grounding. Needs grounding quota on the key.
PALADIN_GROUNDED_SEARCH=1

# Optional paid enrichment. Leave empty to keep them disabled ("provider disabled: no key" in traces).
APOLLO_API_KEY=
TAVILY_API_KEY=

# Demo auth.
PALADIN_SESSION_SECRET=change-me-to-a-long-random-string
PALADIN_OPERATOR_USER=operator
PALADIN_OPERATOR_PASSWORD=

# Cost placeholders in USD per 1M tokens. ASSUMPTIONS: verify against current Gemini pricing.
PALADIN_PRICE_INPUT_PER_M=0.30
PALADIN_PRICE_OUTPUT_PER_M=2.50
PALADIN_PRICE_GROUNDED_REQUEST=0.035
