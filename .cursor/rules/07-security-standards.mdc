  failedLoginAttempts.set(email, attempts + 1);

  if (attempts >= 5) {
    logSecurityEvent({
      type: "brute_force_attempt",
      ip: req.ip,
      userAgent: req.headers["user-agent"],
      details: { email, attempts },
    });

