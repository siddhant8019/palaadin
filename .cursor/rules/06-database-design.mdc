CREATE INDEX idx_enrichment_entity ON data_enrichment_logs(entity_type, entity_id);
CREATE INDEX idx_enrichment_source ON data_enrichment_logs(enrichment_source);
```

### refresh_tokens table

```sql
CREATE TABLE refresh_tokens (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
