CREATE INDEX idx_refresh_tokens_token ON refresh_tokens(token);
CREATE INDEX idx_refresh_tokens_expires ON refresh_tokens(expires_at);
```

### audit_logs table

```sql
CREATE TABLE audit_logs (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  user_id UUID REFERENCES users(id) ON DELETE SET NULL,
  action VARCHAR(100) NOT NULL,
  entity_type VARCHAR(100),
  entity_id UUID,
  changes JSONB,
  ip_address VARCHAR(50),
  user_agent TEXT,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX idx_audit_logs_user ON audit_logs(user_id);
CREATE INDEX idx_audit_logs_action ON audit_logs(action);
CREATE INDEX idx_audit_logs_created ON audit_logs(created_at DESC);
```

## Relationships

### Foreign Keys

- people.company_id → companies.id
- scraping_jobs.user_id → users.id
- user_sessions.user_id → users.id
- file_uploads.user_id → users.id
- refresh_tokens.user_id → users.id
- audit_logs.user_id → users.id

### Cascade Rules

- User deleted → Delete sessions, scraping jobs, file uploads, refresh tokens
- Company deleted → Set people.company_id to NULL (preserve people data)
- Audit logs → Keep even if user deleted (set user_id to NULL)

## Data Integrity Constraints

### Email Validation

```sql
ALTER TABLE users ADD CONSTRAINT valid_email
  CHECK (email ~* '^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$');

ALTER TABLE people ADD CONSTRAINT valid_email
  CHECK (email ~* '^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$');
```

### URL Validation

```sql
ALTER TABLE companies ADD CONSTRAINT valid_linkedin
  CHECK (linkedin_url IS NULL OR linkedin_url ~* '^https?://');

ALTER TABLE people ADD CONSTRAINT valid_linkedin
  CHECK (linkedin_url IS NULL OR linkedin_url ~* '^https?://');
```

### Status Enums

```sql
CREATE TYPE scraping_status AS ENUM (
  'pending',
  'analyzing',
  'scraping',
  'validating',
  'completed',
  'failed'
);

CREATE TYPE file_processing_status AS ENUM (
  'pending',
  'processing',
  'completed',
  'failed'
);
```

## Update Triggers

### Auto-update updated_at

```sql
CREATE OR REPLACE FUNCTION update_updated_at_column()
RETURNS TRIGGER AS $$
BEGIN
  NEW.updated_at = CURRENT_TIMESTAMP;
  RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER update_users_updated_at
  BEFORE UPDATE ON users
  FOR EACH ROW
  EXECUTE FUNCTION update_updated_at_column();

CREATE TRIGGER update_companies_updated_at
  BEFORE UPDATE ON companies
  FOR EACH ROW
  EXECUTE FUNCTION update_updated_at_column();

CREATE TRIGGER update_people_updated_at
  BEFORE UPDATE ON people
  FOR EACH ROW
  EXECUTE FUNCTION update_updated_at_column();

CREATE TRIGGER update_user_sessions_updated_at
  BEFORE UPDATE ON user_sessions
  FOR EACH ROW
  EXECUTE FUNCTION update_updated_at_column();
```

## Database Functions

### Deduplication Function for People

```sql
CREATE OR REPLACE FUNCTION find_duplicate_person(
  p_email VARCHAR,
  p_linkedin_url VARCHAR
) RETURNS UUID AS $$
DECLARE
  existing_id UUID;
BEGIN
  -- Check by email first
  IF p_email IS NOT NULL THEN
    SELECT id INTO existing_id FROM people
    WHERE email = p_email AND is_deleted = false
    LIMIT 1;
    IF existing_id IS NOT NULL THEN
      RETURN existing_id;
    END IF;
  END IF;

  -- Check by LinkedIn URL
  IF p_linkedin_url IS NOT NULL THEN
    SELECT id INTO existing_id FROM people
    WHERE linkedin_url = p_linkedin_url AND is_deleted = false
    LIMIT 1;
    IF existing_id IS NOT NULL THEN
      RETURN existing_id;
    END IF;
  END IF;

  RETURN NULL;
END;
$$ LANGUAGE plpgsql;
```

### Deduplication Function for Companies

```sql
CREATE OR REPLACE FUNCTION find_duplicate_company(
  p_domain VARCHAR,
  p_linkedin_url VARCHAR,
  p_name VARCHAR
) RETURNS UUID AS $$
DECLARE
  existing_id UUID;
BEGIN
  -- Check by domain first
  IF p_domain IS NOT NULL THEN
    SELECT id INTO existing_id FROM companies
    WHERE domain = p_domain AND is_deleted = false
    LIMIT 1;
    IF existing_id IS NOT NULL THEN
      RETURN existing_id;
    END IF;
  END IF;

  -- Check by LinkedIn URL
  IF p_linkedin_url IS NOT NULL THEN
    SELECT id INTO existing_id FROM companies
    WHERE linkedin_url = p_linkedin_url AND is_deleted = false
    LIMIT 1;
    IF existing_id IS NOT NULL THEN
      RETURN existing_id;
    END IF;
  END IF;

  -- Check by name (fuzzy match)
  IF p_name IS NOT NULL THEN
    SELECT id INTO existing_id FROM companies
    WHERE LOWER(name) = LOWER(p_name) AND is_deleted = false
    LIMIT 1;
    IF existing_id IS NOT NULL THEN
      RETURN existing_id;
    END IF;
  END IF;

  RETURN NULL;
END;
$$ LANGUAGE plpgsql;
```

## Migration Strategy

### Version Control

- Use migration tool (Prisma Migrate, TypeORM migrations, or Knex)
- Sequential migration files
- Up and down migrations
- Seed data for development

### Naming Convention

```
YYYYMMDDHHMMSS_descriptive_name.sql

Example:
20250120120000_create_users_table.sql
20250120120100_create_companies_table.sql
20250120120200_create_people_table.sql
```

## Performance Optimization

### Indexing Strategy

- Index all foreign keys
- Index commonly queried fields
- Composite indexes for common query patterns
- GIN indexes for JSONB columns
- Partial indexes for filtered queries

### Query Optimization

- Use EXPLAIN ANALYZE for slow queries
- Add covering indexes where needed
- Partition large tables (audit_logs, data_enrichment_logs)
- Use materialized views for complex aggregations

### Connection Pooling

```typescript
const pool = new Pool({
  host: process.env.DB_HOST,
  port: Number(process.env.DB_PORT),
  database: process.env.DB_NAME,
  user: process.env.DB_USER,
  password: process.env.DB_PASSWORD,
  max: 20,
  idleTimeoutMillis: 30000,
  connectionTimeoutMillis: 2000,
});
```

## Backup and Recovery

### Backup Strategy

- Daily full backups
- Hourly incremental backups
- Point-in-time recovery enabled
- Off-site backup storage

### Data Retention

- Active records: Indefinite
- Soft-deleted records: 90 days
- Audit logs: 1 year
- Scraping jobs: 30 days
- File uploads: 7 days (after processing)
